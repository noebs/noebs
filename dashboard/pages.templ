package dashboard

import (
	"github.com/bradfitz/iter"
)

templ dashboardLayout(title string, brand string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>{ title }</title>
			<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
			<link rel="stylesheet" href="/backoffice/assets/style.css">
		</head>
		<body>
			<nav class="navbar navbar-dark fixed-top bg-dark">
				<div class="container">
					<a class="navbar-brand" href="">{ brand }</a>
					<ul class="navbar-nav mr-auto"></ul>
				</div>
			</nav>
			{ children... }
		</body>
	</html>
}

templ DashboardIndexPage() {
	@dashboardLayout("Solus | Secure Payments", "Solus") {
		<main role="main">
		</main>
	}
}

templ DashboardTablePage(data DashboardTableView) {
	@dashboardLayout("Dashboard", "Tuti Middleware") {
		<main role="main">
			<div class="container">
				<div class="row">
					<div class="col">
						<form action={ data.BasePath } method="get">
							<label for="terminal-filter">Terminal ID</label>
							<label>
								<input id="terminal-filter" type="search" placeholder="Search terminal IDs" name="tid" value={ data.TerminalIDFilter }>
							</label>
							<button type="submit" class="btn btn-outline-primary btn-sm">Search</button>
						</form>
					</div>
					<div class="col">
						<a class="btn btn-primary btn-sm" role="button" href={ dashboardStreamURL(data) }>Download matching data</a>
					</div>
				</div>

				<div class="row">
					<div class="col">
						<ul class="list-group list-group-horizontal-sm">
							<li class="list-group-item d-flex justify-content-between align-items-center">
								Matching transactions
								<span class="badge badge-primary badge-pill">{ data.Stats.NumberTransactions }</span>
							</li>
							<li class="list-group-item d-flex justify-content-between align-items-center">
								Approved by EBS
								<span class="badge badge-primary badge-pill">{ data.Stats.SuccessfulTransactions }</span>
							</li>
							<li class="list-group-item d-flex justify-content-between align-items-center">
								Rejected or unknown
								<span class="badge badge-primary badge-pill">{ data.Stats.FailedTransactions }</span>
							</li>
						</ul>
					</div>
				</div>

				<div class="row">
					<div class="col">
						<table class="table table-striped table-sm">
							<thead class="thead-dark">
								<tr>
									<th scope="col">ID</th>
									<th scope="col">Date Time</th>
									<th scope="col">Amount</th>
									<th scope="col">Currency</th>
									<th scope="col">Reference Number</th>
									<th scope="col">Approval Code</th>
									<th scope="col">Terminal ID</th>
									<th scope="col">Response Code</th>
									<th scope="col">Service</th>
								</tr>
							</thead>
							for _, tran := range data.Transactions {
								<tr>
									<th scope="row">{ tran.ID }</th>
									<td>{ TimeFormatter(tran.CreatedAt) }</td>
									<td>{ tran.TranAmount }</td>
									<td>{ transactionCurrency(tran) }</td>
									<td>{ tran.ReferenceNumber }</td>
									<td>{ tran.ApprovalCode }</td>
									<td>{ tran.TerminalID }</td>
									<td>{ tran.ResponseCode }</td>
									<td>{ tran.EBSServiceName }</td>
								</tr>
							}
						</table>
					</div>
				</div>

				<div class="row">
					<div class="col-sm">
						<ul class="pagination pagination-sm">
							for i := range iter.N(data.PageCount) {
								<li class={ "page-item", templ.KV("active", i + 1 == data.CurrentPage) }>
									<a class="page-link" href={ dashboardPageURL(data, i + 1) }>{ i + 1 }</a>
								</li>
							}
						</ul>
					</div>
				</div>
			</div>
		</main>
	}
}

templ QRStatusPage(data QRStatusView) {
	@dashboardLayout("Dashboard", "2T Merchant") {
		<main role="main">
			<div class="container">
				<div class="row">
					<div class="col">
						<table class="table table-striped table-sm">
							<thead class="thead-dark">
								<tr>
									<th scope="col">Merchant ID</th>
									<th scope="col">Date Time</th>
									<th scope="col">Amount</th>
									<th scope="col">Status</th>
									<th scope="col">Transaction ID</th>
								</tr>
							</thead>
							for _, tran := range data.Transactions {
								<tr>
									<td>{ tran.MerchantID }</td>
									<td>{ tran.TranDateTime }</td>
									<td>{ tran.TranAmount }</td>
									<td>{ tran.ResponseMessage }</td>
									<td>{ tran.TransactionID }</td>
								</tr>
							}
						</table>
					</div>
				</div>

				<hr>
			</div>
		</main>
	}
}

templ SearchPage() {
	@dashboardLayout("Dashboard", "Solus") {
		<main role="main">
		</main>
	}
}
