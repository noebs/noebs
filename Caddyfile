api.noebs.sd, dsa.adonese.sd {
    handle /psp/webhooks* {
        reverse_proxy psp-webhook:8080
    }

    handle {
        reverse_proxy api-gateway:8080
    }

    encode gzip zstd

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    log {
        output stdout
        format json
    }
}
