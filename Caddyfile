api.noebs.sd, dsa.adonese.sd {
    @identity path /generate_api_key /consumer/register /consumer/register_with_card /consumer/login /consumer/refresh /consumer/otp/* /consumer/auth/* /consumer/user /consumer/user/lang /consumer/user/device /consumer/change_password /consumer/check_user /consumer/kyc
    handle @identity {
        reverse_proxy identity-auth:8080
    }

    @cardVault path /consumer/card_info /consumer/pan_from_mobile /consumer/cards/new /consumer/cards/complete /consumer/nec2name /consumer/get_cards /consumer/add_card /consumer/edit_card /consumer/delete_card /consumer/cards/set_main /consumer/users/cards /consumer/mobile2pan /consumer/payment_token /consumer/payment_request /consumer/payment_token/quick_pay
    handle @cardVault {
        reverse_proxy card-vault:8080
    }

    @ebsAdapter path /ebs/* /workingKey /cardTransfer /voucher /voucher/cash_in /cashout /voucher/cash_out /purchase /cashIn /cashOut /billInquiry /billPayment /bills /changePin /miniStatement /isAlive /balance /refund /toAccount /statement /wrk /consumer/balance /consumer/status /consumer/is_alive /consumer/bill_payment /consumer/bills /consumer/guess_biller /consumer/bill_inquiry /consumer/p2p /consumer/cashIn /consumer/cashOut /consumer/account /consumer/purchase /consumer/n/status /consumer/key /consumer/ipin /consumer/generate_qr /consumer/qr_payment /consumer/qr_status /consumer/qr_refund /consumer/qr_complete /consumer/ipin_key /consumer/generate_ipin /consumer/complete_ipin /consumer/vouchers/generate /consumer/transaction /consumer/transactions /consumer/p2p_mobile
    handle @ebsAdapter {
        reverse_proxy ebs-adapter:8080
    }

    @walletAPI path /wallet /wallet/* /admin/wallet /admin/wallet/*
    handle @walletAPI {
        reverse_proxy wallet-api:8080
    }

    handle /psp/webhooks* {
        reverse_proxy psp-webhook:8080
    }

    handle /dashboard* {
        reverse_proxy admin-reporting:8080
    }

    handle /ws {
        reverse_proxy notification-chat:8080
    }

    handle /consumer/notifications* {
        reverse_proxy notification-chat:8080
    }

    handle /consumer/submit_contacts* {
        reverse_proxy notification-chat:8080
    }

    handle {
        reverse_proxy api-gateway:8080
    }

    encode gzip zstd

    header {
        X-Content-Type-Options nosniff
        X-Frame-Options DENY
        Referrer-Policy strict-origin-when-cross-origin
    }

    log {
        output stdout
        format json
    }
}
