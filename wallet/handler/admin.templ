package handler

templ adminNav(tenantID string) {
	<div class="btn-group" role="group" aria-label="Wallet admin navigation">
		<a class="btn btn-sm btn-outline-secondary" href={ adminWalletPath(tenantID, "") }>Overview</a>
		<a class="btn btn-sm btn-outline-secondary" href={ adminWalletPath(tenantID, "/wallets") }>Wallets</a>
		<a class="btn btn-sm btn-outline-secondary" href={ adminWalletPath(tenantID, "/transactions") }>Transactions</a>
		<a class="btn btn-sm btn-outline-secondary" href={ adminWalletPath(tenantID, "/pending") }>Pending</a>
		<a class="btn btn-sm btn-outline-secondary" href={ adminWalletPath(tenantID, "/manual") }>Manual</a>
		<a class="btn btn-sm btn-outline-secondary" href={ adminWalletPath(tenantID, "/fees") }>Fees</a>
		<a class="btn btn-sm btn-outline-secondary" href={ adminWalletPath(tenantID, "/rates") }>Rates</a>
		<a class="btn btn-sm btn-outline-secondary" href={ adminWalletPath(tenantID, "/audit") }>Audit</a>
	</div>
}

templ adminLayout(title string, tenantID string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta name="viewport" content="width=device-width, initial-scale=1">
			<title>{ title }</title>
			<link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.3.1/css/bootstrap.min.css" integrity="sha384-ggOyR0iXCbMQv3Xipma34MD+dH/1fQ784/j6cY/iJTQUOhcWr7x9JvoRxT2MZw1T" crossorigin="anonymous">
			<link rel="stylesheet" href="/backoffice/assets/style.css">
		</head>
		<body>
			<nav class="navbar navbar-dark fixed-top bg-dark">
				<div class="container">
					<a class="navbar-brand" href={ adminWalletPath(tenantID, "") }>Wallet Admin</a>
					<form method="post" action="/backoffice/logout">
						<input type="hidden" name="_csrf" value={ backofficeCSRF(ctx) }>
						<button type="submit">Sign out</button>
					</form>
				</div>
			</nav>
			<main role="main" class="container">
				<div class="d-flex flex-wrap align-items-center justify-content-between mb-4">
					<div>
						<h1 class="h3 mb-1">{ title }</h1>
						<div class="text-muted">Tenant: { displayTenant(tenantID) }</div>
					</div>
					<div class="mt-2 mt-sm-0">
						@adminNav(tenantID)
					</div>
				</div>
				{ children... }
			</main>
		</body>
	</html>
}

templ WalletDashboardPage(data WalletDashboardView) {
	@adminLayout("Wallet Admin", data.TenantID) {
		<div class="list-group">
			<a class="list-group-item list-group-item-action" href={ adminWalletPath(data.TenantID, "/wallets") }>Wallets</a>
			<a class="list-group-item list-group-item-action" href={ adminWalletPath(data.TenantID, "/pending") }>Pending Approvals</a>
			<a class="list-group-item list-group-item-action" href={ adminWalletPath(data.TenantID, "/audit") }>Audit Log</a>
		</div>
	}
}

templ WalletListPage(data WalletListView) {
	@adminLayout("Wallets", data.TenantID) {
		if len(data.Wallets) == 0 {
			<div class="alert alert-secondary">No wallets found.</div>
		} else {
			<div class="table-responsive">
				<table class="table table-striped table-sm">
					<thead class="thead-dark">
						<tr>
							<th>ID</th>
							<th>Owner</th>
							<th>Currency</th>
							<th>Balance</th>
							<th>Available</th>
							<th>Status</th>
							<th>KYC</th>
							<th>Created</th>
						</tr>
					</thead>
					<tbody>
						for _, w := range data.Wallets {
							<tr>
								<td><a href={ adminWalletPath(data.TenantID, "/wallets/" + w.ID.String()) }>{ w.ID.String() }</a></td>
								<td>{ w.OwnerType }/{ w.OwnerID }</td>
								<td>{ w.Currency }</td>
								<td>{ w.Balance }</td>
								<td>{ w.AvailableBalance }</td>
								<td>{ w.Status }</td>
								<td>{ w.KYCTier }</td>
								<td>{ formatTime(w.CreatedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ WalletDetailPage(data WalletDetailView) {
	@adminLayout("Wallet Detail", data.TenantID) {
		<div class="card mb-4">
			<div class="card-body">
				<h5 class="card-title">Wallet { data.Wallet.ID.String() }</h5>
				<p class="card-text">Owner: { data.Wallet.OwnerType }/{ data.Wallet.OwnerID }</p>
				<p class="card-text">Currency: { data.Wallet.Currency }</p>
				<p class="card-text">Balance: { data.Wallet.Balance } (Available: { data.Wallet.AvailableBalance })</p>
				<p class="card-text">Status: { data.Wallet.Status }</p>
				<p class="card-text">KYC: { data.Wallet.KYCTier }</p>
			</div>
		</div>

		<h3 class="h5">Funding Sources</h3>
		if len(data.FundingSources) == 0 {
			<div class="alert alert-secondary">No funding sources found.</div>
		} else {
			<div class="table-responsive">
				<table class="table table-striped table-sm">
					<thead class="thead-dark">
						<tr>
							<th>ID</th>
							<th>Type</th>
							<th>Provider</th>
							<th>External Ref</th>
							<th>Currency</th>
							<th>Total Funded</th>
							<th>Total Withdrawn</th>
							<th>Verified</th>
						</tr>
					</thead>
					<tbody>
						for _, source := range data.FundingSources {
							<tr>
								<td>{ source.ID }</td>
								<td>{ source.SourceType }</td>
								<td>{ formatNullString(source.PSPProvider) }</td>
								<td>{ formatNullString(source.ExternalReference) }</td>
								<td>{ source.Currency }</td>
								<td>{ source.TotalFunded }</td>
								<td>{ source.TotalWithdrawn }</td>
								<td>{ source.VerificationStatus }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}

		<h3 class="h5 mt-4">Withdrawal Destinations</h3>
		if len(data.Destinations) == 0 {
			<div class="alert alert-secondary">No destinations found.</div>
		} else {
			<div class="table-responsive">
				<table class="table table-striped table-sm">
					<thead class="thead-dark">
						<tr>
							<th>ID</th>
							<th>Type</th>
							<th>Provider</th>
							<th>Currency</th>
							<th>Funding source</th>
							<th>Active</th>
							<th>Total Withdrawn</th>
						</tr>
					</thead>
					<tbody>
						for _, dest := range data.Destinations {
							<tr>
								<td>{ dest.ID }</td>
								<td>{ dest.DestinationType }</td>
								<td>{ formatNullString(dest.PSPProvider) }</td>
								<td>{ dest.Currency }</td>
								<td>{ dest.LinkedFundingSourceID }</td>
								<td>{ dest.IsActive }</td>
								<td>{ dest.TotalWithdrawn }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ PendingApprovalsPage(data PendingApprovalsView) {
	@adminLayout("Pending Approvals", data.TenantID) {
		<h2 class="h5">Manual Transfers</h2>
		if len(data.ManualTransfers) == 0 {
			<div class="alert alert-secondary">No pending manual transfers.</div>
		} else {
			<div class="table-responsive">
				<table class="table table-striped table-sm">
					<thead class="thead-dark">
						<tr>
							<th>Workflow</th>
							<th>Type</th>
							<th>Wallet</th>
							<th>Requested By</th>
							<th>Amount</th>
							<th>Currency</th>
							<th>Requested</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, transfer := range data.ManualTransfers {
							<tr>
									<td><a href={ adminWalletPath(data.TenantID, "/manual/" + transfer.WorkflowID) }>{ transfer.WorkflowID }</a></td>
								<td>{ transfer.TransferType }</td>
								<td>{ formatNullString(transfer.WalletID) }</td>
								<td>{ transfer.RequestedByOperatorID }</td>
								<td>{ transfer.Amount }</td>
								<td>{ transfer.Currency }</td>
								<td>{ formatTime(transfer.RequestedAt) }</td>
								<td>
									<form method="post" class="form-inline">
										<input type="hidden" name="_csrf" value={ backofficeCSRF(ctx) }>
										<input type="hidden" name="kind" value="manual_transfer">
										<input type="text" name="proof_of_payment" class="form-control form-control-sm mb-2 mr-sm-2" placeholder="Proof">
										<input type="text" name="reason" class="form-control form-control-sm mb-2 mr-sm-2" placeholder="Reason">
										<button class="btn btn-sm btn-success mb-2 mr-1" formaction={ adminWalletPath(data.TenantID, "/approve/" + transfer.WorkflowID) }>Approve</button>
										<button class="btn btn-sm btn-danger mb-2" formaction={ adminWalletPath(data.TenantID, "/reject/" + transfer.WorkflowID) }>Reject</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}

		<h2 class="h5 mt-4">Withdrawals</h2>
		if len(data.Withdrawals) == 0 {
			<div class="alert alert-secondary">No pending withdrawal approvals.</div>
		} else {
			<div class="table-responsive">
				<table class="table table-striped table-sm">
					<thead class="thead-dark">
						<tr>
							<th>Workflow</th>
							<th>Client Ref</th>
							<th>Wallet</th>
							<th>Amount</th>
							<th>Currency</th>
							<th>Provider</th>
							<th>Requested</th>
							<th>Actions</th>
						</tr>
					</thead>
					<tbody>
						for _, item := range data.Withdrawals {
							<tr>
								<td>{ item.WorkflowID }</td>
								<td>{ item.ClientRef }</td>
								<td>{ item.WalletID }</td>
								<td>{ item.Amount }</td>
								<td>{ item.Currency }</td>
								<td>{ item.Provider }</td>
								<td>{ formatTime(item.RequestedAt) }</td>
								<td>
									<form method="post" class="form-inline">
										<input type="hidden" name="_csrf" value={ backofficeCSRF(ctx) }>
										<input type="hidden" name="kind" value="withdrawal">
										<input type="text" name="proof_of_payment" class="form-control form-control-sm mb-2 mr-sm-2" placeholder="Proof">
										<input type="text" name="reason" class="form-control form-control-sm mb-2 mr-sm-2" placeholder="Reason">
										<button class="btn btn-sm btn-success mb-2 mr-1" formaction={ adminWalletPath(data.TenantID, "/approve/" + item.WorkflowID) }>Approve</button>
										<button class="btn btn-sm btn-danger mb-2" formaction={ adminWalletPath(data.TenantID, "/reject/" + item.WorkflowID) }>Reject</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ AuditLogPage(data AuditLogView) {
	@adminLayout("Audit Log", data.TenantID) {
		<form method="get" class="mb-3">
			<div class="form-row">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="event_type" placeholder="Event type" value={ data.Filter.EventType }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="actor_type" placeholder="Actor type" value={ data.Filter.ActorType }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="actor_id" placeholder="Actor ID" value={ data.Filter.ActorID }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="target_type" placeholder="Target type" value={ data.Filter.TargetType }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="target_id" placeholder="Target ID" value={ data.Filter.TargetID }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="action" placeholder="Action" value={ data.Filter.Action }>
				</div>
			</div>
			<div class="form-row mt-2">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="start" placeholder="Start (RFC3339)" value={ data.Filter.Start }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="end" placeholder="End (RFC3339)" value={ data.Filter.End }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="limit" placeholder="Limit" value={ data.Filter.Limit }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="offset" placeholder="Offset" value={ data.Filter.Offset }>
				</div>
				<div class="col">
					<button class="btn btn-sm btn-primary" type="submit">Filter</button>
				</div>
			</div>
		</form>

		if len(data.Events) == 0 {
			<div class="alert alert-secondary">No audit events found.</div>
		} else {
			<div class="table-responsive">
				<table class="table table-striped table-sm">
					<thead class="thead-dark">
						<tr>
							<th>Time</th>
							<th>Event</th>
							<th>Actor</th>
							<th>Action</th>
							<th>Target</th>
							<th>Workflow</th>
							<th>Request</th>
							<th>Metadata</th>
						</tr>
					</thead>
					<tbody>
						for _, evt := range data.Events {
							<tr>
								<td>{ formatTime(evt.CreatedAt) }</td>
								<td>{ evt.EventType }</td>
								<td>{ evt.ActorType }/{ evt.ActorID }</td>
								<td>{ evt.Action }</td>
								<td>{ formatNullString(evt.TargetType) }/{ formatNullString(evt.TargetID) }</td>
								<td>{ formatNullString(evt.WorkflowID) }</td>
								<td>{ formatNullString(evt.RequestID) }</td>
								<td><code>{ formatJSON(evt.Metadata) }</code></td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ PSPTransactionsPage(data PSPTransactionsView) {
	@adminLayout("PSP Transactions", data.TenantID) {
		<form method="get" class="mb-3">
			<div class="form-row">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="status" placeholder="Status" value={ data.Filter.Status }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="provider" placeholder="Provider" value={ data.Filter.Provider }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="direction" placeholder="Direction" value={ data.Filter.Direction }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="client_reference" placeholder="Client ref" value={ data.Filter.ClientRef }>
				</div>
			</div>
			<div class="form-row mt-2">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="start" placeholder="Start (RFC3339)" value={ data.Filter.Start }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="end" placeholder="End (RFC3339)" value={ data.Filter.End }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="limit" placeholder="Limit" value={ data.Filter.Limit }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="offset" placeholder="Offset" value={ data.Filter.Offset }>
				</div>
				<div class="col">
					<button class="btn btn-sm btn-primary" type="submit">Filter</button>
				</div>
			</div>
		</form>

		if len(data.Transactions) == 0 {
			<div class="alert alert-secondary">No transactions found.</div>
		} else {
			<div class="table-responsive">
				<table class="table table-striped table-sm">
					<thead class="thead-dark">
						<tr>
							<th>Client Ref</th>
							<th>Provider</th>
							<th>Direction</th>
							<th>Status</th>
							<th>Amount</th>
							<th>Currency</th>
							<th>Workflow</th>
							<th>Created</th>
						</tr>
					</thead>
					<tbody>
						for _, txn := range data.Transactions {
							<tr>
								<td><a href={ adminWalletPath(data.TenantID, "/transactions/" + txn.ClientReference) }>{ txn.ClientReference }</a></td>
								<td>{ txn.PSPProvider }</td>
								<td>{ txn.Direction }</td>
								<td>{ txn.Status }</td>
								<td>{ txn.Amount }</td>
								<td>{ txn.Currency }</td>
								<td>{ formatNullString(txn.WorkflowID) }</td>
								<td>{ formatTime(txn.CreatedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ PSPTransactionDetailPage(data PSPTransactionDetailView) {
	@adminLayout("PSP Transaction", data.TenantID) {
		<div class="card mb-3">
			<div class="card-body">
				<h5 class="card-title">Client Ref { data.Transaction.ClientReference }</h5>
				<p class="card-text">Provider: { data.Transaction.PSPProvider }</p>
				<p class="card-text">Direction: { data.Transaction.Direction }</p>
				<p class="card-text">Status: { data.Transaction.Status }</p>
				<p class="card-text">Amount: { data.Transaction.Amount } { data.Transaction.Currency }</p>
				<p class="card-text">Workflow: { formatNullString(data.Transaction.WorkflowID) }</p>
				<p class="card-text">PSP Txn: { formatNullString(data.Transaction.PSPTransactionID) }</p>
				<p class="card-text">Response: { formatNullString(data.Transaction.ResponseCode) } { formatNullString(data.Transaction.ResponseMessage) }</p>
				<p class="card-text">Created: { formatTime(data.Transaction.CreatedAt) }</p>
				<p class="card-text">Confirmed: { formatNullTime(data.Transaction.ConfirmedAt) }</p>
				<p class="card-text">Last Polled: { formatNullTime(data.Transaction.LastPolledAt) }</p>
				<p class="card-text">Next Poll: { formatNullTime(data.Transaction.NextPollAt) }</p>
			</div>
		</div>

		<h3 class="h6">Raw Request</h3>
		<pre class="bg-light p-3 border rounded"><code>{ formatJSON(data.Transaction.RawRequest) }</code></pre>
		<h3 class="h6 mt-3">Raw Response</h3>
		<pre class="bg-light p-3 border rounded"><code>{ formatJSON(data.Transaction.RawResponse) }</code></pre>
	}
}

templ ManualTransferFormPage(data ManualTransferFormView) {
	@adminLayout("Manual Transfers", data.TenantID) {
		<form method="post" class="mb-4">
			<input type="hidden" name="_csrf" value={ backofficeCSRF(ctx) }>
			<div class="form-row">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="idempotency_key" placeholder="Idempotency key" value={ data.Values.IdempotencyKey }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="wallet_id" placeholder="Wallet ID" value={ data.Values.WalletID }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="transfer_type" placeholder="manual_credit/manual_debit" value={ data.Values.TransferType }>
				</div>
			</div>
			<div class="form-row mt-2">
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="amount" placeholder="Amount" value={ data.Values.Amount }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="currency" placeholder="Currency" value={ data.Values.Currency }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="reason" placeholder="Reason" value={ data.Values.Reason }>
				</div>
			</div>
			<div class="form-row mt-2">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="psp_provider" placeholder="PSP provider (optional)" value={ data.Values.PSPProvider }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="psp_reference" placeholder="PSP reference (optional)" value={ data.Values.PSPReference }>
				</div>
			</div>
			<div class="form-row mt-2">
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="approval_timeout_seconds" placeholder="Approval timeout seconds" value={ data.Values.ApprovalTTL }>
				</div>
				<div class="col">
					<button class="btn btn-sm btn-primary" type="submit">Submit</button>
				</div>
			</div>
		</form>

		<form method="get" class="mb-3">
			<div class="form-row">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="status" placeholder="Status" value={ data.Filter.Status }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="transfer_type" placeholder="Transfer type" value={ data.Filter.TransferType }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="wallet_id" placeholder="Wallet ID" value={ data.Filter.WalletID }>
				</div>
			</div>
			<div class="form-row mt-2">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="start" placeholder="Start (RFC3339)" value={ data.Filter.Start }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="end" placeholder="End (RFC3339)" value={ data.Filter.End }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="limit" placeholder="Limit" value={ data.Filter.Limit }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="offset" placeholder="Offset" value={ data.Filter.Offset }>
				</div>
				<div class="col">
					<button class="btn btn-sm btn-primary" type="submit">Filter</button>
				</div>
			</div>
		</form>

		if len(data.Transfers) == 0 {
			<div class="alert alert-secondary">No manual transfers found.</div>
		} else {
			<div class="table-responsive">
				<table class="table table-striped table-sm">
					<thead class="thead-dark">
						<tr>
							<th>Workflow</th>
							<th>Status</th>
							<th>Type</th>
							<th>Wallet</th>
							<th>Requested By</th>
							<th>Amount</th>
							<th>Currency</th>
							<th>Requested</th>
						</tr>
					</thead>
					<tbody>
						for _, transfer := range data.Transfers {
							<tr>
								<td><a href={ adminWalletPath(data.TenantID, "/manual/" + transfer.WorkflowID) }>{ transfer.WorkflowID }</a></td>
								<td>{ transfer.Status }</td>
								<td>{ transfer.TransferType }</td>
								<td>{ formatNullString(transfer.WalletID) }</td>
								<td>{ transfer.RequestedByOperatorID }</td>
								<td>{ transfer.Amount }</td>
								<td>{ transfer.Currency }</td>
								<td>{ formatTime(transfer.RequestedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ ManualTransferDetailPage(data ManualTransferDetailView) {
	@adminLayout("Manual Transfer Detail", data.TenantID) {
		<div class="card mb-4">
			<div class="card-body">
				<h5 class="card-title">Workflow { data.Transfer.WorkflowID }</h5>
				<p class="card-text">Status: { data.Transfer.Status }</p>
				<p class="card-text">Type: { data.Transfer.TransferType }</p>
				<p class="card-text">Wallet: { formatNullString(data.Transfer.WalletID) }</p>
				<p class="card-text">Requested By: { data.Transfer.RequestedByOperatorID }</p>
				<p class="card-text">Amount: { data.Transfer.Amount } { data.Transfer.Currency }</p>
				<p class="card-text">Reason: { data.Transfer.Reason }</p>
				<p class="card-text">Requested At: { formatTime(data.Transfer.RequestedAt) }</p>
				<p class="card-text">Approved By: { formatNullInt64(data.Transfer.ApprovedByOperatorID) }</p>
				<p class="card-text">Approved At: { formatNullTime(data.Transfer.ApprovedAt) }</p>
				<p class="card-text">Completed At: { formatNullTime(data.Transfer.CompletedAt) }</p>
				<p class="card-text">Proof: { formatNullString(data.Transfer.ProofOfPayment) }</p>
				<p class="card-text">Rejection Reason: { formatNullString(data.Transfer.RejectionReason) }</p>
			</div>
		</div>

		<h3 class="h6">Approvals</h3>
		if len(data.Approvals) == 0 {
			<div class="alert alert-secondary">No approvals recorded.</div>
		} else {
			<div class="table-responsive">
				<table class="table table-striped table-sm">
					<thead class="thead-dark">
						<tr>
							<th>Approver</th>
							<th>Decision</th>
							<th>Reason</th>
							<th>Decided At</th>
						</tr>
					</thead>
					<tbody>
						for _, approval := range data.Approvals {
							<tr>
								<td>{ approval.DecidedByOperatorID }</td>
								<td>{ approval.Decision }</td>
								<td>{ formatNullString(approval.Reason) }</td>
								<td>{ formatTime(approval.DecidedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ FeesPage(data FeeConfigView) {
	@adminLayout("Fee Configs", data.TenantID) {
		<form method="post" class="mb-4">
			<input type="hidden" name="_csrf" value={ backofficeCSRF(ctx) }>
			<div class="form-row">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="transaction_type" placeholder="Transaction type" value={ data.Form.TransactionType }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="currency" placeholder="Currency" value={ data.Form.Currency }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="tier_min" placeholder="Tier min" value={ data.Form.TierMin }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="tier_max" placeholder="Tier max" value={ data.Form.TierMax }>
				</div>
			</div>
			<div class="form-row mt-2">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="percentage_fee" placeholder="Percentage fee" value={ data.Form.PercentageFee }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="flat_fee" placeholder="Flat fee" value={ data.Form.FlatFee }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="min_fee" placeholder="Min fee" value={ data.Form.MinFee }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="max_fee" placeholder="Max fee" value={ data.Form.MaxFee }>
				</div>
			</div>
			<div class="form-row mt-2">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="fee_account_code" placeholder="Fee account code" value={ data.Form.FeeAccountCode }>
				</div>
				<div class="col">
					<div class="form-check mt-2">
						<input class="form-check-input" type="checkbox" name="is_active" id="fee-active" checked={ data.Form.IsActive }>
						<label class="form-check-label" for="fee-active">Active</label>
					</div>
				</div>
				<div class="col">
					<button class="btn btn-sm btn-primary mt-1" type="submit">Add Fee Config</button>
				</div>
			</div>
		</form>

		<form method="get" class="mb-3">
			<div class="form-row">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="transaction_type" placeholder="Transaction type" value={ data.Filter.TransactionType }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="currency" placeholder="Currency" value={ data.Filter.Currency }>
				</div>
				<div class="col">
					<div class="form-check mt-2">
						<input class="form-check-input" type="checkbox" name="active_only" id="fee-active-only" checked={ data.Filter.ActiveOnly }>
						<label class="form-check-label" for="fee-active-only">Active only</label>
					</div>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="limit" placeholder="Limit" value={ data.Filter.Limit }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="offset" placeholder="Offset" value={ data.Filter.Offset }>
				</div>
				<div class="col">
					<button class="btn btn-sm btn-primary" type="submit">Filter</button>
				</div>
			</div>
		</form>

		if len(data.Configs) == 0 {
			<div class="alert alert-secondary">No fee configs found.</div>
		} else {
			<div class="table-responsive">
				<table class="table table-striped table-sm">
					<thead class="thead-dark">
						<tr>
							<th>Type</th>
							<th>Currency</th>
							<th>Tier Min</th>
							<th>Tier Max</th>
							<th>Percent</th>
							<th>Flat</th>
							<th>Min</th>
							<th>Max</th>
							<th>Account</th>
							<th>Active</th>
							<th>Created By</th>
							<th>Created</th>
						</tr>
					</thead>
					<tbody>
						for _, cfg := range data.Configs {
							<tr>
								<td>{ cfg.TransactionType }</td>
								<td>{ cfg.Currency }</td>
								<td>{ cfg.TierMin }</td>
								<td>{ formatNullInt64(cfg.TierMax) }</td>
								<td>{ cfg.PercentageFee.String() }</td>
								<td>{ cfg.FlatFee }</td>
								<td>{ cfg.MinFee }</td>
								<td>{ formatNullInt64(cfg.MaxFee) }</td>
								<td>{ formatNullString(cfg.FeeAccountCode) }</td>
								<td>{ cfg.IsActive }</td>
								<td>{ cfg.CreatedByOperatorID }</td>
								<td>{ formatTime(cfg.CreatedAt) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}

templ RatesPage(data RateView) {
	@adminLayout("Exchange Rates", data.TenantID) {
		<form method="post" class="mb-4">
			<input type="hidden" name="_csrf" value={ backofficeCSRF(ctx) }>
			<div class="form-row">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="base_currency" placeholder="Base currency" value={ data.Form.BaseCurrency }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="quote_currency" placeholder="Quote currency" value={ data.Form.QuoteCurrency }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="buy_rate" placeholder="Buy rate" value={ data.Form.BuyRate }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="sell_rate" placeholder="Sell rate" value={ data.Form.SellRate }>
				</div>
			</div>
			<div class="form-row mt-2">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="spread" placeholder="Spread (optional)" value={ data.Form.Spread }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="effective_from" placeholder="Effective from (RFC3339)" value={ data.Form.EffectiveFrom }>
				</div>
				<div class="col">
					<button class="btn btn-sm btn-primary" type="submit">Add Rate</button>
				</div>
			</div>
		</form>

		<form method="get" class="mb-3">
			<div class="form-row">
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="base_currency" placeholder="Base currency" value={ data.Filter.BaseCurrency }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="text" name="quote_currency" placeholder="Quote currency" value={ data.Filter.QuoteCurrency }>
				</div>
				<div class="col">
					<div class="form-check mt-2">
						<input class="form-check-input" type="checkbox" name="active_only" id="rate-active-only" checked={ data.Filter.ActiveOnly }>
						<label class="form-check-label" for="rate-active-only">Active only</label>
					</div>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="limit" placeholder="Limit" value={ data.Filter.Limit }>
				</div>
				<div class="col">
					<input class="form-control form-control-sm" type="number" name="offset" placeholder="Offset" value={ data.Filter.Offset }>
				</div>
				<div class="col">
					<button class="btn btn-sm btn-primary" type="submit">Filter</button>
				</div>
			</div>
		</form>

		if len(data.Rates) == 0 {
			<div class="alert alert-secondary">No exchange rates found.</div>
		} else {
			<div class="table-responsive">
				<table class="table table-striped table-sm">
					<thead class="thead-dark">
						<tr>
							<th>Pair</th>
							<th>Buy</th>
							<th>Sell</th>
							<th>Spread</th>
							<th>Set By</th>
							<th>Effective From</th>
							<th>Effective To</th>
						</tr>
					</thead>
					<tbody>
						for _, rate := range data.Rates {
							<tr>
								<td>{ rate.BaseCurrency }/{ rate.QuoteCurrency }</td>
								<td>{ rate.BuyRate.String() }</td>
								<td>{ rate.SellRate.String() }</td>
								<td>{ formatNullDecimal(rate.Spread) }</td>
								<td>{ rate.SetByOperatorID }</td>
								<td>{ formatTime(rate.EffectiveFrom) }</td>
								<td>{ formatNullTime(rate.EffectiveTo) }</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	}
}
