noebs:
  default_tenant_id: REPLACE_WITH_TENANT_ID
  admin_key: REPLACE_WITH_GATEWAY_ADMIN_KEY
  admin_user: REPLACE_WITH_GATEWAY_ADMIN_USER
  admin_password: REPLACE_WITH_GATEWAY_ADMIN_PASSWORD
  sms_key: REPLACE_WITH_SMS_API_KEY
  sms_sender: REPLACE_WITH_SMS_SENDER
  sms_gateway: REPLACE_WITH_SMS_GATEWAY
  sms_message: REPLACE_WITH_SMS_MESSAGE
  google_client_id: REPLACE_WITH_GOOGLE_CLIENT_ID
  google_client_secret: REPLACE_WITH_GOOGLE_CLIENT_SECRET
  google_redirect_url: REPLACE_WITH_GOOGLE_REDIRECT_URL
  card_vault_data_key: REPLACE_WITH_CARD_VAULT_DATA_KEY
  temporal_postgres_password: REPLACE_WITH_TEMPORAL_POSTGRES_PASSWORD
  keycloak_postgres_password: REPLACE_WITH_KEYCLOAK_POSTGRES_PASSWORD
  keycloak_bootstrap_admin_username: REPLACE_WITH_KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME
  keycloak_bootstrap_admin_password: REPLACE_WITH_KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD
  ghcr_dockerconfigjson: '{"auths":{"ghcr.io":{"auth":"REPLACE_WITH_GHCR_AUTH_BASE64"}}}'
  ebs:
    consumer_endpoint: REPLACE_WITH_EBS_CONSUMER_ENDPOINT
    merchant_endpoint: REPLACE_WITH_EBS_MERCHANT_ENDPOINT
    ipin_endpoint: REPLACE_WITH_EBS_IPIN_ENDPOINT
    consumer_app_id: REPLACE_WITH_EBS_CONSUMER_APP_ID
    merchant_app_id: REPLACE_WITH_EBS_MERCHANT_APP_ID
    ipin_username: REPLACE_WITH_EBS_IPIN_USERNAME
    ipin_password: REPLACE_WITH_EBS_IPIN_PASSWORD
    pub_key: REPLACE_WITH_EBS_CONSUMER_PUBLIC_KEY
    ipin_key: REPLACE_WITH_EBS_IPIN_PUBLIC_KEY
    pan: REPLACE_WITH_BILL_INQUIRY_PAN
    pin: REPLACE_WITH_BILL_INQUIRY_PIN
    ipin: REPLACE_WITH_BILL_INQUIRY_IPIN
    exp_date: REPLACE_WITH_BILL_INQUIRY_EXPIRY
  psp:
    REPLACE_WITH_TENANT_ID:
      REPLACE_WITH_PROVIDER_CODE:
        api_key: REPLACE_WITH_PSP_API_KEY
        api_secret: REPLACE_WITH_PSP_API_SECRET
        webhook_secret: REPLACE_WITH_PSP_WEBHOOK_SECRET
        webhook_public_key: REPLACE_WITH_PSP_WEBHOOK_PUBLIC_KEY
