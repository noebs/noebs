(common_headers) {
	encode gzip zstd
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}
}

dsa.adonese.sd {
	import common_headers
	reverse_proxy 127.0.0.1:8080

	log {
		output stdout
		format json
	}
}

api.noebs.sd {
	import common_headers

	route {
		@assetlinks path /.well-known/assetlinks.json
		header @assetlinks Content-Type application/json
		header @assetlinks Cache-Control "public, max-age=3600"
		respond @assetlinks `[{"relation":["delegate_permission/common.handle_all_urls"],"target":{"namespace":"android_app","package_name":"com.tutipay.app.alpha","sha256_cert_fingerprints":["B4:45:C2:79:FE:FB:B0:95:AA:33:4F:67:42:4D:EA:6B:52:77:38:EA:FF:A5:EF:FB:80:B5:E2:F5:9B:66:1C:AE"]}}]` 200

		@keycloak_metadata {
			method GET HEAD
			path /auth/realms/noebs/.well-known/openid-configuration /auth/realms/noebs/protocol/openid-connect/certs /auth/resources/*
		}
		reverse_proxy @keycloak_metadata https://keycloak.noebs.svc.cluster.local:8443 {
			transport http {
				tls_trust_pool file /etc/noebs-internal/ca.pem
				tls_server_name keycloak.noebs.svc.cluster.local
			}
			header_up X-Forwarded-Port 443
			header_up X-Forwarded-Proto https
		}

		@keycloak_browser_get {
			method GET
			path /auth/realms/noebs/protocol/openid-connect/auth /auth/realms/noebs/protocol/openid-connect/logout /auth/realms/noebs/login-actions/authenticate /auth/realms/noebs/login-actions/required-action /auth/realms/noebs/login-actions/restart /auth/realms/noebs/login-actions/first-broker-login /auth/realms/noebs/login-actions/post-broker-login /auth/realms/noebs/broker/google/login /auth/realms/noebs/broker/google/endpoint /auth/realms/noebs/broker/after-first-broker-login /auth/realms/noebs/broker/after-post-broker-login
		}
		reverse_proxy @keycloak_browser_get https://keycloak.noebs.svc.cluster.local:8443 {
			transport http {
				tls_trust_pool file /etc/noebs-internal/ca.pem
				tls_server_name keycloak.noebs.svc.cluster.local
			}
			header_up X-Forwarded-Port 443
			header_up X-Forwarded-Proto https
		}

		@keycloak_browser_post {
			method POST
			path /auth/realms/noebs/protocol/openid-connect/token /auth/realms/noebs/login-actions/authenticate /auth/realms/noebs/login-actions/required-action /auth/realms/noebs/login-actions/first-broker-login /auth/realms/noebs/login-actions/post-broker-login /auth/realms/noebs/broker/after-post-broker-login
		}
		reverse_proxy @keycloak_browser_post https://keycloak.noebs.svc.cluster.local:8443 {
			transport http {
				tls_trust_pool file /etc/noebs-internal/ca.pem
				tls_server_name keycloak.noebs.svc.cluster.local
			}
			header_up X-Forwarded-Port 443
			header_up X-Forwarded-Proto https
		}

		@keycloak_private path /auth /auth/*
		respond @keycloak_private 404

		reverse_proxy https://api-gateway.noebs.svc.cluster.local:8080 {
			transport http {
				tls_trust_pool file /etc/noebs-internal/ca.pem
				tls_server_name api-gateway.noebs.svc.cluster.local
				tls_client_auth /etc/noebs-internal/tls.crt /etc/noebs-internal/tls.key
			}
		}
	}

	log {
		output stdout
		format filter {
			request>headers>X-Noebs-Transaction-Authorization delete
			request>headers>X-CSRF-Token delete
			request>headers>X-Webhook-Signature delete
			resp_headers>Location delete
			request>uri query {
				replace request REDACTED
				replace code REDACTED
				replace state REDACTED
				replace session_state REDACTED
				replace session_code REDACTED
				replace client_data REDACTED
				replace id_token_hint REDACTED
				replace nonce REDACTED
				replace code_challenge REDACTED
				replace tab_id REDACTED
				replace execution REDACTED
			}
			wrap json
		}
	}
}

