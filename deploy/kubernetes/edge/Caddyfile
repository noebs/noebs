unido.noebs.sd {
	import common_headers

	handle_path /bo* {
		reverse_proxy 172.21.0.5:8080
	}

	@api_paths path /api/* /openapi.json /openapi.yaml
	handle @api_paths {
		reverse_proxy 172.21.0.4:8080
	}

	handle /auth* {
		reverse_proxy 127.0.0.1:18081
	}

	handle {
		reverse_proxy 172.21.0.7:8080
	}

	log {
		output stdout
		format json
	}
}

