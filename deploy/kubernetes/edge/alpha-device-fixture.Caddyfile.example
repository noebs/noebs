	# Insert this matcher immediately before the unqualified api.noebs.sd
	# reverse_proxy during a reviewed, temporary device-lab session. Replace both
	# placeholders with values printed by scripts/alpha-device-fixture.sh.
	@alpha_device_fixture {
		header X-Tenant-ID alpha-device-REPLACE_WITH_RUN
		path /test /app/config /consumer/*
	}
	reverse_proxy @alpha_device_fixture 127.0.0.1:REPLACE_WITH_PORT

	@alpha_device_fixture_block {
		header X-Tenant-ID alpha-device-REPLACE_WITH_RUN
		not path /test /app/config /consumer/*
	}
	respond @alpha_device_fixture_block 404
