noebs:
  default_tenant_id: REPLACE_WITH_TENANT_ID
  service_databases:
    wallet-ledger: postgres://wallet_ledger_worker:REPLACE_WITH_WALLET_LEDGER_WORKER_PASSWORD_BASE64URL@db:5432/wallet_ledger?sslmode=verify-full
  database_ca_certificate: REPLACE_WITH_DATABASE_CA_CERTIFICATE
  temporal_client_secret: REPLACE_WITH_TEMPORAL_WALLET_WORKER_CLIENT_SECRET_BASE64URL
  temporal_ca_certificate: REPLACE_WITH_TEMPORAL_CA_CERTIFICATE
  keycloak_ca_certificate: REPLACE_WITH_KEYCLOAK_CA_CERTIFICATE
  psp:
    REPLACE_WITH_TENANT_ID:
      REPLACE_WITH_PROVIDER_CODE:
        api_key: REPLACE_WITH_PSP_API_KEY
        api_secret: REPLACE_WITH_PSP_API_SECRET
        webhook_secret: REPLACE_WITH_PSP_WEBHOOK_SECRET
        webhook_public_key: REPLACE_WITH_PSP_WEBHOOK_PUBLIC_KEY
