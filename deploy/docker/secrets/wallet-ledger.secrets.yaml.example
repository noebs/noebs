noebs:
  default_tenant_id: REPLACE_WITH_TENANT_ID
  service_databases:
    wallet-ledger: postgres://wallet_ledger_runtime:REPLACE_WITH_WALLET_LEDGER_RUNTIME_PASSWORD_BASE64URL@db:5432/wallet_ledger?sslmode=verify-full
  database_ca_certificate: REPLACE_WITH_DATABASE_CA_CERTIFICATE
  internal_transport:
    ca_certificate: REPLACE_WITH_DATABASE_CA_CERTIFICATE
    certificate: REPLACE_WITH_WALLET_LEDGER_INTERNAL_TRANSPORT_CERTIFICATE
    private_key: REPLACE_WITH_WALLET_LEDGER_INTERNAL_TRANSPORT_PRIVATE_KEY
  temporal_client_secret: REPLACE_WITH_TEMPORAL_WALLET_LEDGER_CLIENT_SECRET_BASE64URL
  temporal_ca_certificate: REPLACE_WITH_TEMPORAL_CA_CERTIFICATE
  keycloak_ca_certificate: REPLACE_WITH_KEYCLOAK_CA_CERTIFICATE
