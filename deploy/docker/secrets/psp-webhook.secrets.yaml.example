noebs:
  default_tenant_id: REPLACE_WITH_TENANT_ID
  service_databases:
    wallet-ledger: postgres://wallet_ledger_webhook:REPLACE_WITH_WALLET_LEDGER_WEBHOOK_PASSWORD_BASE64URL@db:5432/wallet_ledger?sslmode=verify-full
  database_ca_certificate: REPLACE_WITH_DATABASE_CA_CERTIFICATE
  internal_transport:
    ca_certificate: REPLACE_WITH_DATABASE_CA_CERTIFICATE
    certificate: REPLACE_WITH_PSP_WEBHOOK_INTERNAL_TRANSPORT_CERTIFICATE
    private_key: REPLACE_WITH_PSP_WEBHOOK_INTERNAL_TRANSPORT_PRIVATE_KEY
  workload_auth:
    nonce_db_url: postgres://workload_auth_runtime:REPLACE_WITH_WORKLOAD_AUTH_RUNTIME_PASSWORD@db:5432/workload_auth?sslmode=verify-full
    trusted_keys:
      REPLACE_WITH_API_GATEWAY_SIGNING_KEY_ID:
        caller: api-gateway
        public_key: REPLACE_WITH_API_GATEWAY_SIGNING_PUBLIC_KEY
  psp:
    REPLACE_WITH_TENANT_ID:
      REPLACE_WITH_PROVIDER_CODE:
        api_key: REPLACE_WITH_PSP_API_KEY
        api_secret: REPLACE_WITH_PSP_API_SECRET
        webhook_secret: REPLACE_WITH_PSP_WEBHOOK_SECRET
        webhook_public_key: REPLACE_WITH_PSP_WEBHOOK_PUBLIC_KEY
