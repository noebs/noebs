noebs:
  default_tenant_id: REPLACE_WITH_TENANT_ID
  service_databases:
    ebs-adapter: postgres://ebs_adapter_runtime:REPLACE_WITH_EBS_ADAPTER_RUNTIME_PASSWORD_BASE64URL@db:5432/ebs_adapter?sslmode=verify-full
  database_ca_certificate: REPLACE_WITH_DATABASE_CA_CERTIFICATE
  internal_transport:
    ca_certificate: REPLACE_WITH_DATABASE_CA_CERTIFICATE
    certificate: REPLACE_WITH_EBS_ADAPTER_INTERNAL_TRANSPORT_CERTIFICATE
    private_key: REPLACE_WITH_EBS_ADAPTER_INTERNAL_TRANSPORT_PRIVATE_KEY
  workload_auth:
    signing_key_id: REPLACE_WITH_EBS_ADAPTER_SIGNING_KEY_ID
    signing_private_key: REPLACE_WITH_EBS_ADAPTER_SIGNING_PRIVATE_KEY
    nonce_db_url: postgres://workload_auth_runtime:REPLACE_WITH_WORKLOAD_AUTH_RUNTIME_PASSWORD@db:5432/workload_auth?sslmode=verify-full
    trusted_keys:
      REPLACE_WITH_API_GATEWAY_SIGNING_KEY_ID:
        caller: api-gateway
        public_key: REPLACE_WITH_API_GATEWAY_SIGNING_PUBLIC_KEY
  consumer_endpoint: REPLACE_WITH_EBS_CONSUMER_ENDPOINT
  merchant_endpoint: REPLACE_WITH_EBS_MERCHANT_ENDPOINT
  ipin_endpoint: REPLACE_WITH_EBS_IPIN_ENDPOINT
  consumer_app_id: REPLACE_WITH_EBS_CONSUMER_APP_ID
  merchant_app_id: REPLACE_WITH_EBS_MERCHANT_APP_ID
  ipin_username: REPLACE_WITH_EBS_IPIN_USERNAME
  ipin_password: REPLACE_WITH_EBS_IPIN_PASSWORD
  pub_key: REPLACE_WITH_EBS_CONSUMER_PUBLIC_KEY
  ipin_key: REPLACE_WITH_EBS_IPIN_PUBLIC_KEY
  pan: REPLACE_WITH_BILL_INQUIRY_PAN
  pin: REPLACE_WITH_BILL_INQUIRY_PIN
  ipin: REPLACE_WITH_BILL_INQUIRY_IPIN
  exp_date: REPLACE_WITH_BILL_INQUIRY_EXPIRY
