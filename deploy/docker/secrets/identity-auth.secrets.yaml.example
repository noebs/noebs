  google_client_secret: REPLACE_WITH_GOOGLE_CLIENT_SECRET
  google_redirect_url: REPLACE_WITH_GOOGLE_REDIRECT_URL
  sms_key: REPLACE_WITH_SMS_API_KEY
  sms_sender: REPLACE_WITH_SMS_SENDER
  sms_gateway: REPLACE_WITH_SMS_GATEWAY_URL
  sms_message: REPLACE_WITH_SMS_MESSAGE
