noebs:
  default_tenant_id: REPLACE_WITH_TENANT_ID
  service_databases:
    identity-auth: REPLACE_WITH_IDENTITY_AUTH_DATABASE_URL
  jwt_secret: REPLACE_WITH_JWT_SIGNING_SECRET
