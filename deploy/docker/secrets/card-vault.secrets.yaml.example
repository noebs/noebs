noebs:
  default_tenant_id: REPLACE_WITH_TENANT_ID
  service_databases:
    card-vault: postgres://card_vault_runtime:REPLACE_WITH_CARD_VAULT_RUNTIME_PASSWORD_BASE64URL@db:5432/card_vault?sslmode=verify-full
  database_ca_certificate: REPLACE_WITH_DATABASE_CA_CERTIFICATE
  internal_transport:
    ca_certificate: REPLACE_WITH_DATABASE_CA_CERTIFICATE
    certificate: REPLACE_WITH_CARD_VAULT_INTERNAL_TRANSPORT_CERTIFICATE
    private_key: REPLACE_WITH_CARD_VAULT_INTERNAL_TRANSPORT_PRIVATE_KEY
  data_key: REPLACE_WITH_CARD_VAULT_DATA_KEY
  workload_auth:
    nonce_db_url: postgres://workload_auth_runtime:REPLACE_WITH_WORKLOAD_AUTH_RUNTIME_PASSWORD@db:5432/workload_auth?sslmode=verify-full
    trusted_keys:
      REPLACE_WITH_API_GATEWAY_SIGNING_KEY_ID:
        caller: api-gateway
        public_key: REPLACE_WITH_API_GATEWAY_SIGNING_PUBLIC_KEY
      REPLACE_WITH_EBS_ADAPTER_SIGNING_KEY_ID:
        caller: ebs-adapter
        public_key: REPLACE_WITH_EBS_ADAPTER_SIGNING_PUBLIC_KEY
