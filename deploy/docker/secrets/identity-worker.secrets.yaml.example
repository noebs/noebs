noebs:
  default_tenant_id: REPLACE_WITH_TENANT_ID
  service_databases:
    identity-auth: postgres://identity_auth_runtime:REPLACE_WITH_IDENTITY_AUTH_RUNTIME_PASSWORD_BASE64URL@db:5432/identity_auth?sslmode=verify-full
  database_ca_certificate: REPLACE_WITH_DATABASE_CA_CERTIFICATE
  temporal_client_secret: REPLACE_WITH_TEMPORAL_IDENTITY_WORKER_CLIENT_SECRET_BASE64URL
  temporal_ca_certificate: REPLACE_WITH_TEMPORAL_CA_CERTIFICATE
  keycloak_ca_certificate: REPLACE_WITH_KEYCLOAK_CA_CERTIFICATE
