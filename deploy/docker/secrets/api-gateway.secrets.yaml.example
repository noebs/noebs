noebs:
  default_tenant_id: REPLACE_WITH_TENANT_ID
  service_databases:
    api-gateway: postgres://gateway_auth_runtime:REPLACE_WITH_GATEWAY_AUTH_RUNTIME_PASSWORD@db:5432/gateway_auth?sslmode=verify-full
  database_ca_certificate: REPLACE_WITH_DATABASE_CA_CERTIFICATE
  keycloak_ca_certificate: REPLACE_WITH_KEYCLOAK_CA_CERTIFICATE
  internal_transport:
    ca_certificate: REPLACE_WITH_DATABASE_CA_CERTIFICATE
    certificate: REPLACE_WITH_API_GATEWAY_INTERNAL_TRANSPORT_CERTIFICATE
    private_key: REPLACE_WITH_API_GATEWAY_INTERNAL_TRANSPORT_PRIVATE_KEY
  backoffice_client_secret: REPLACE_WITH_BACKOFFICE_CLIENT_SECRET
  wallet_authorizer_client_secret: REPLACE_WITH_WALLET_AUTHORIZER_CLIENT_SECRET
  gateway_auth_encryption_key_id: REPLACE_WITH_GATEWAY_AUTH_ENCRYPTION_KEY_ID
  gateway_auth_encryption_keys:
    REPLACE_WITH_GATEWAY_AUTH_ENCRYPTION_KEY_ID: REPLACE_WITH_GATEWAY_AUTH_ENCRYPTION_KEY
  workload_auth:
    signing_key_id: REPLACE_WITH_API_GATEWAY_WORKLOAD_SIGNING_KEY_ID
    signing_private_key: REPLACE_WITH_API_GATEWAY_WORKLOAD_SIGNING_PRIVATE_KEY
  psp_webhook_routes:
    REPLACE_WITH_PSP_WEBHOOK_CALLBACK_ID_BASE64URL:
      tenant_id: REPLACE_WITH_TENANT_ID
      provider_code: REPLACE_WITH_PROVIDER_CODE
