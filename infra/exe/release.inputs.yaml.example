noebs:
  default_tenant_id: REPLACE_WITH_TENANT_ID
  service_database_passwords:
    admin_reporting_migrate: REPLACE_WITH_ADMIN_REPORTING_MIGRATE_PASSWORD_BASE64URL
    admin_reporting_projector: REPLACE_WITH_ADMIN_REPORTING_PROJECTOR_PASSWORD_BASE64URL
    admin_reporting_runtime: REPLACE_WITH_ADMIN_REPORTING_RUNTIME_PASSWORD_BASE64URL
    card_vault_migrate: REPLACE_WITH_CARD_VAULT_MIGRATE_PASSWORD_BASE64URL
    card_vault_runtime: REPLACE_WITH_CARD_VAULT_RUNTIME_PASSWORD_BASE64URL
    ebs_adapter_events: REPLACE_WITH_EBS_ADAPTER_EVENTS_PASSWORD_BASE64URL
    ebs_adapter_migrate: REPLACE_WITH_EBS_ADAPTER_MIGRATE_PASSWORD_BASE64URL
    ebs_adapter_runtime: REPLACE_WITH_EBS_ADAPTER_RUNTIME_PASSWORD_BASE64URL
    identity_auth_migrate: REPLACE_WITH_IDENTITY_AUTH_MIGRATE_PASSWORD_BASE64URL
    identity_auth_runtime: REPLACE_WITH_IDENTITY_AUTH_RUNTIME_PASSWORD_BASE64URL
    notification_chat_migrate: REPLACE_WITH_NOTIFICATION_CHAT_MIGRATE_PASSWORD_BASE64URL
    notification_chat_runtime: REPLACE_WITH_NOTIFICATION_CHAT_RUNTIME_PASSWORD_BASE64URL
    wallet_ledger_migrate: REPLACE_WITH_WALLET_LEDGER_MIGRATE_PASSWORD_BASE64URL
    wallet_ledger_runtime: REPLACE_WITH_WALLET_LEDGER_RUNTIME_PASSWORD_BASE64URL
    wallet_ledger_worker: REPLACE_WITH_WALLET_LEDGER_WORKER_PASSWORD_BASE64URL
    wallet_ledger_webhook: REPLACE_WITH_WALLET_LEDGER_WEBHOOK_PASSWORD_BASE64URL
  card_vault_data_key: REPLACE_WITH_CARD_VAULT_DATA_KEY
  temporal_postgres_password: REPLACE_WITH_TEMPORAL_POSTGRES_PASSWORD
  keycloak_postgres_password: REPLACE_WITH_KEYCLOAK_POSTGRES_PASSWORD
  ghcr_dockerconfigjson: '{"auths":{"ghcr.io":{"auth":"REPLACE_WITH_GHCR_AUTH_BASE64"}}}'
  keycloak:
    # Match the credential keys in keycloak-desired-state.yaml. Use {} when
    # identity_providers in desired state is [] for local accounts only.
    identity_providers:
      google:
        client_id: REPLACE_WITH_GOOGLE_CLIENT_ID
        client_secret: REPLACE_WITH_GOOGLE_CLIENT_SECRET
    # Required when local_accounts.verify_email or reset_password_allowed is true.
    smtp:
      host: REPLACE_WITH_SMTP_HOST
      port: 465
      from: REPLACE_WITH_SMTP_FROM_EMAIL
      from_display_name: REPLACE_WITH_BRAND_NAME
      username: REPLACE_WITH_SMTP_USERNAME
      password: REPLACE_WITH_SMTP_PASSWORD
      tls: true
    reconciler_client_secret: REPLACE_WITH_KEYCLOAK_RECONCILER_CLIENT_SECRET_BASE64URL
    backoffice_client_secret: REPLACE_WITH_KEYCLOAK_BACKOFFICE_CLIENT_SECRET_BASE64URL
    web_client_secret: REPLACE_WITH_KEYCLOAK_WEB_CLIENT_SECRET_BASE64URL
    account_enroller_client_secret: REPLACE_WITH_KEYCLOAK_ACCOUNT_ENROLLER_CLIENT_SECRET_BASE64URL
    wallet_authorizer_client_secret: REPLACE_WITH_KEYCLOAK_WALLET_AUTHORIZER_CLIENT_SECRET_BASE64URL
    temporal_ledger_client_secret: REPLACE_WITH_KEYCLOAK_TEMPORAL_LEDGER_CLIENT_SECRET_BASE64URL
    temporal_worker_client_secret: REPLACE_WITH_KEYCLOAK_TEMPORAL_WORKER_CLIENT_SECRET_BASE64URL
    temporal_identity_client_secret: REPLACE_WITH_KEYCLOAK_TEMPORAL_IDENTITY_CLIENT_SECRET_BASE64URL
    temporal_identity_worker_client_secret: REPLACE_WITH_KEYCLOAK_TEMPORAL_IDENTITY_WORKER_CLIENT_SECRET_BASE64URL
    temporal_bootstrap_client_secret: REPLACE_WITH_KEYCLOAK_TEMPORAL_BOOTSTRAP_CLIENT_SECRET_BASE64URL
  gateway_auth:
    database:
      migrate_password: REPLACE_WITH_GATEWAY_AUTH_MIGRATE_PASSWORD_BASE64URL
      runtime_password: REPLACE_WITH_GATEWAY_AUTH_RUNTIME_PASSWORD_BASE64URL
      cleanup_password: REPLACE_WITH_GATEWAY_AUTH_CLEANUP_PASSWORD_BASE64URL
    encryption_key_id: REPLACE_WITH_GATEWAY_AUTH_ENCRYPTION_KEY_ID
    encryption_keys:
      REPLACE_WITH_GATEWAY_AUTH_ENCRYPTION_KEY_ID: REPLACE_WITH_GATEWAY_AUTH_ENCRYPTION_KEY_BASE64
  workload_auth:
    callers:
      api-gateway:
        key_id: REPLACE_WITH_API_GATEWAY_WORKLOAD_KEY_ID
        private_key: REPLACE_WITH_API_GATEWAY_WORKLOAD_PRIVATE_KEY_BASE64
      ebs-adapter:
        key_id: REPLACE_WITH_EBS_ADAPTER_WORKLOAD_KEY_ID
        private_key: REPLACE_WITH_EBS_ADAPTER_WORKLOAD_PRIVATE_KEY_BASE64
    database:
      migrate_password: REPLACE_WITH_WORKLOAD_AUTH_MIGRATE_PASSWORD
      runtime_password: REPLACE_WITH_WORKLOAD_AUTH_RUNTIME_PASSWORD
      cleanup_password: REPLACE_WITH_WORKLOAD_AUTH_CLEANUP_PASSWORD
  internal_transport:
    ca_certificate: REPLACE_WITH_INTERNAL_TRANSPORT_CA_CERTIFICATE_PEM
    ca_private_key: REPLACE_WITH_INTERNAL_TRANSPORT_CA_PRIVATE_KEY_PEM
  ebs:
    consumer_endpoint: REPLACE_WITH_EBS_CONSUMER_ENDPOINT
    merchant_endpoint: REPLACE_WITH_EBS_MERCHANT_ENDPOINT
    ipin_endpoint: REPLACE_WITH_EBS_IPIN_ENDPOINT
    consumer_app_id: REPLACE_WITH_EBS_CONSUMER_APP_ID
    merchant_app_id: REPLACE_WITH_EBS_MERCHANT_APP_ID
    ipin_username: REPLACE_WITH_EBS_IPIN_USERNAME
    ipin_password: REPLACE_WITH_EBS_IPIN_PASSWORD
    pub_key: REPLACE_WITH_EBS_CONSUMER_PUBLIC_KEY
    ipin_key: REPLACE_WITH_EBS_IPIN_PUBLIC_KEY
    pan: REPLACE_WITH_BILL_INQUIRY_PAN
    pin: REPLACE_WITH_BILL_INQUIRY_PIN
    ipin: REPLACE_WITH_BILL_INQUIRY_IPIN
    exp_date: REPLACE_WITH_BILL_INQUIRY_EXPIRY
  psp:
    REPLACE_WITH_TENANT_ID:
      REPLACE_WITH_PROVIDER_CODE:
        callback_id: REPLACE_WITH_PSP_WEBHOOK_CALLBACK_ID_BASE64URL
        api_key: REPLACE_WITH_PSP_API_KEY
        api_secret: REPLACE_WITH_PSP_API_SECRET
        webhook_secret: REPLACE_WITH_PSP_WEBHOOK_SECRET
        webhook_public_key: REPLACE_WITH_PSP_WEBHOOK_PUBLIC_KEY
